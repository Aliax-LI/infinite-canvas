{
    "name": "infinite-canvas",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite --host 0.0.0.0 --port 3000",
        "build": "tsc --noEmit && vite build",
        "electron:dev": "concurrently -k \"vite --host 0.0.0.0 --port 3000\" \"wait-on http://127.0.0.1:3000 && electron .\"",
        "electron:pack": "bun run build && electron-builder --dir",
        "electron:dist": "bun run build && electron-builder",
        "electron:dist:win": "bun run build && electron-builder --win nsis --x64",
        "electron:dist:mac": "bun run build && electron-builder --mac dmg zip --x64 --arm64",
        "start": "vite preview --host 0.0.0.0 --port 3000",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "build": {
        "appId": "com.infinite-canvas.app",
        "productName": "Infinite Canvas",
        "icon": "electron/icon.png",
        "files": [
            "dist/**",
            "electron/**",
            "package.json"
        ],
        "directories": {
            "output": "release"
        },
        "mac": {
            "icon": "electron/icon.icns",
            "target": [
                "dmg",
                "zip"
            ],
            "artifactName": "InfiniteCanvas-${version}-mac-${arch}.${ext}"
        },
        "win": {
            "icon": "electron/icon.ico",
            "target": "nsis",
            "artifactName": "InfiniteCanvas-${version}-win-${arch}.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Infinite Canvas"
        }
    },
    "dependencies": {
        "@ant-design/icons": "^6.1.1",
        "@ant-design/pro-components": "3.0.0-beta.3",
        "@codemirror/lang-json": "^6.0.2",
        "@tanstack/react-query": "^5.100.9",
        "@uiw/react-codemirror": "^4.25.9",
        "antd": "^6.4.2",
        "axios": "^1.16.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "copy-to-clipboard": "^4.0.2",
        "dayjs": "^1.11.20",
        "fflate": "^0.8.3",
        "file-saver": "^2.0.5",
        "localforage": "^1.10.0",
        "lucide-react": "^1.16.0",
        "motion": "^12.38.0",
        "nanoid": "^5.1.11",
        "radix-ui": "^1.4.3",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-router": "^7.12.0",
        "react-router-dom": "^7.12.0",
        "shadcn": "^4.7.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^20",
        "@types/react": "19.1.12",
        "@types/react-dom": "19.1.9",
        "@vitejs/plugin-react": "^5.2.0",
        "concurrently": "^10.0.3",
        "electron": "^43.0.0",
        "electron-builder": "^26.15.3",
        "prettier": "^3.8.3",
        "typescript": "^5",
        "vite": "^7.3.0",
        "wait-on": "^9.0.10"
    }
}
